# Copy to deploy/.env on the SERVER and fill in. NEVER commit the real file (deploy/.gitignore blocks it).
# Generate secrets without printing them, for example:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" >> .env
#   printf 'WENDY_AGENT_TOKEN=%s\n'  "$(openssl rand -hex 24)" >> .env
#   printf 'WENDY_API_TOKEN=%s\n'    "$(openssl rand -hex 24)" >> .env

# Public address (a DNS A record must already point to this server) and the e-mail Let's Encrypt uses for expiry notices.
WENDY_DOMAIN=wendy.example.com
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=
# Shared secrets between the web and the private services (>= 24 and >= 32 characters).
WENDY_AGENT_TOKEN=
WENDY_API_TOKEN=

# Whose Wendy this is (must match the principal in the restored database).
WENDY_PRINCIPAL_EMAIL=

# Login of the web app: hash and session secret, produced by `npx tsx scripts/web-password-hash.ts` (see README).
WENDY_WEB_PASSWORD_HASH=
WENDY_SESSION_SECRET=

# Model (Vertex AI). The service-account file goes in deploy/secrets/vertex-sa.json (never in this file).
GOOGLE_CLOUD_PROJECT=
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview
# Optional: faster model for the small front-of-chat calls only.
GEMINI_FAST_MODEL=
