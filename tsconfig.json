{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": { "@/lib/*": ["./web/lib/*"], "next/server": ["./web/node_modules/next/server.d.ts"] }
  },
  "include": ["src", "tests", "fixtures", "scripts", "inspector"]
}
